# All of these are optional — the backend runs fine with zero config using
# the defaults baked into main.go. Set real values before deploying anywhere
# public.

PORT=8080
JWT_SECRET=dev-secret-change-me-before-production
FRONTEND_URL=http://localhost:5173

# Shared secret that scripts/textbook_fetcher must send to add library
# books. Set this to something real and put the same value in
# scripts/textbook_fetcher/.env as INGEST_KEY.
INGEST_SECRET=dev-ingest-secret-change-me
